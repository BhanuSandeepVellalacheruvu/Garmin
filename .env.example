# ============================================================
# Garmin AI Performance Lab — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ─── Application ────────────────────────────────────────────
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change-me-to-a-random-64-char-hex-string
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://garmin:change_me@postgres:5432/garmin_lab
POSTGRES_USER=garmin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=garmin_lab

# ─── Garmin Integration ─────────────────────────────────────
# Options: official | compatible | mock
# Use "mock" for demo mode without a Garmin account
GARMIN_PROVIDER=mock

# Required when GARMIN_PROVIDER=official:
# Obtain from: Garmin Connect Web → Settings → API → Personal API Keys
# See README.md → "Obtaining Your Garmin Personal API Key"
GARMIN_PERSONAL_API_KEY=

# The official Garmin Connect Personal API base URL
# Do not change unless directed by Garmin documentation
GARMIN_API_BASE_URL=https://personal.connectapi.garmin.com

# How often to automatically sync data (minutes)
SYNC_INTERVAL_MINUTES=60

# ─── LLM / AI Coach ─────────────────────────────────────────
# Options: ollama | openai_compatible | mock
# Use "mock" for development without a running LLM
LLM_PROVIDER=mock

# For ollama: LLM_BASE_URL=http://ollama:11434/v1 (Docker) or http://localhost:11434/v1 (local)
# For openai_compatible: your inference server URL
LLM_BASE_URL=http://localhost:11434/v1

# API key — leave empty for local Ollama (no auth required)
LLM_API_KEY=

# Model to use. For Ollama: llama3.2, mistral, etc.
# Run: ollama pull llama3.2  to download the model first
LLM_MODEL=llama3.2

# ─── Redis (Optional) ───────────────────────────────────────
# Only required if background task queue is enabled
# Leave empty to disable Redis
REDIS_URL=

# ─── Frontend ───────────────────────────────────────────────
# The URL that browsers use to reach the backend API
# In Docker: http://localhost:8000
# In production: https://your-domain.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000
